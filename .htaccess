# СТАНДАРТНАЯ КОДИРОВКА
AddDefaultCharset UTF-8

# УПРАВЛЕНИЕ ОШИБКАМИ И ОТЛАДКА
php_flag display_errors on
php_value error_reporting -1
php_flag html_errors on

# НАСТРОЙКА ИНДЕКСА И ЗАЩИТА
DirectoryIndex index.php index.html
Options -Indexes

# ПРАВИЛА ДЛЯ ЧПУ (MOD_REWRITE)
RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

# -----------------------------------------------------------------
# БЛОК ДЛЯ ОТКЛЮЧЕНИЯ КЭШИРОВАНИЯ CSS/JS ВО ВРЕМЯ РАЗРАБОТКИ
# -----------------------------------------------------------------
<IfModule mod_headers>
    # Для CSS и JavaScript: установить немедленное устаревание
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>